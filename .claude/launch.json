{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rbit",
      "runtimeExecutable": "cargo",
      "runtimeArgs": [
        "run",
        "--",
        "serve"
      ],
      "port": 3000
    },
    {
      "name": "rbit-alt",
      "runtimeExecutable": "pwsh",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:RBIT_SERVER__BIND='127.0.0.1:3001'; $env:RBIT_SERVER__PUBLIC_URL='http://localhost:3001'; $env:RBIT_STORAGE__DATA_DIR='data-alt'; $env:RBIT_MAIL__TRANSPORT='log'; cargo run -- serve"
      ],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "rbit-live",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/dev.mjs"
      ],
      "port": 3000
    }
  ]
}
