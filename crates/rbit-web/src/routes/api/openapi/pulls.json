          },
          "assignees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            }
          },
          "requested_reviewers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            }
          },
          "draft": {
            "type": "boolean"
          },
          "head": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "sha": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "repo": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Repository"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "base": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "sha": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "repo": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Repository"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "merged": {
            "type": "boolean"
          },
          "mergeable": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "mergeable_state": {
            "type": "string",
            "enum": [
              "clean",
              "dirty",
              "blocked",
              "unknown",
              "draft"
            ]
          },
          "merged_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "merged_by": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Account"
              },
              {
                "type": "null"
              }
            ]
          },
          "merge_commit_sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "comments": {
            "type": "integer"
          },
          "review_comments": {
            "type": "integer"
          },
          "commits": {
            "type": "integer"
          },
          "additions": {
            "type": "integer"
          },
          "deletions": {
            "type": "integer"
          },
          "changed_files": {
            "type": "integer"
          },
          "html_url": {
            "type": "string",
            "format": "uri"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "closed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "NewPullRequest": {
        "type": "object",
        "required": [
          "head",
          "base"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Defaults to the single commit's summary or the branch name."
          },
          "head": {
            "type": "string",
            "description": "`branch`, `owner:branch` or `owner/name:branch`."
          },
          "base": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "draft": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "PullRequestChanges": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ]
          },
          "base": {
            "type": "string"
          }
        }
      },
      "PullRequestFile": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "previous_filename": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "added",
              "removed",
              "modified",
              "renamed",
              "copied"
            ]
          },
          "additions": {
            "type": "integer"
          },
          "deletions": {
            "type": "integer"
          },
          "changes": {
            "type": "integer"
          },
          "patch": {
            "type": [
              "string",
              "null"
            ],
            "description": "Unified diff hunks; null for binary or very large files."
          }
        }
      },
      "MergeRequest": {
        "type": "object",
        "properties": {
          "merge_method": {
            "type": "string",
            "enum": [
              "merge",
              "squash",
              "rebase"
            ],
            "default": "merge"
          },
          "commit_title": {
            "type": "string"
          },
          "commit_message": {
            "type": "string"
          },
          "sha": {
            "type": "string",
            "description": "The head the caller reviewed; a different head is a 409."
          }
        }
      },
      "MergeResult": {
        "type": "object",
        "properties": {
          "sha": {
            "type": "string"
          },
          "merged": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "PullRequestReview": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "user": {
            "$ref": "#/components/schemas/Account"
          },
          "body": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDING",
              "COMMENTED",
              "APPROVED",
              "CHANGES_REQUESTED",
              "DISMISSED"
            ]
          },
          "commit_id": {
            "type": "string"
          },
          "submitted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "html_url": {
            "type": "string",
            "format": "uri"
          },
          "pull_request_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "NewPullRequestReview": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string"
          },
          "event": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REQUEST_CHANGES",
              "COMMENT"
            ]
          },
          "comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NewPullRequestReviewComment"
            }
          }
        }
      },
      "PullRequestReviewComment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "pull_request_review_id": {
            "type": "integer"
          },
          "user": {
            "$ref": "#/components/schemas/Account"
          },
          "body": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "LEFT",
              "RIGHT"
            ]
          },
          "line": {
            "type": "integer"
          },
          "commit_id": {
            "type": "string"
          },
          "diff_hunk": {
            "type": "string"
          },
          "in_reply_to_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "outdated": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "html_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "NewPullRequestReviewComment": {
        "type": "object",
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "side": {
            "type": "string",
            "enum": [
              "LEFT",
              "RIGHT"
            ],
            "default": "RIGHT"
          },
          "in_reply_to": {
            "type": "integer",
            "description": "Reply to this comment (path and line are then taken from it)."
          }
        }
      },
      "RequestedReviewers": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            }
          },
          "teams": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "ReviewerNames": {
        "type": "object",
        "required": [
          "reviewers"
        ],
        "properties": {
          "reviewers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 15
          }
        }
      }
    }
  }
}
