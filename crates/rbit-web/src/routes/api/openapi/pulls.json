    "/repos/{owner}/{repo}/pulls/{number}/merge": {
      "get": {
        "operationId": "checkPullRequestMerged",
        "tags": [
          "pulls"
        ],
        "summary": "Whether the pull request was merged",
        "parameters": [
          {
            "$ref": "#/components/parameters/owner"
          },
          {
            "$ref": "#/components/parameters/repo"
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "description": "The pull request number.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Merged"
          },
          "404": {
            "description": "Not merged (or not found)"
          }
        }
      },
      "put": {
        "operationId": "mergePullRequest",
        "tags": [
          "pulls"
        ],
        "summary": "Merge the pull request",
        "parameters": [
          {
            "$ref": "#/components/parameters/owner"
          },
          {
            "$ref": "#/components/parameters/repo"
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "description": "The pull request number.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Merged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MergeResult"
                }
              }
            }
          },
          "405": {
            "description": "Not mergeable (conflicts, a draft, unmet requirements)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "`sha` is not the head",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MergeRequest"
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      }
    },
