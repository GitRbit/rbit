  "components": {
    "schemas": {
      "ActionsRepositoryPermissions": {
        "type": "object",
        "required": [
          "enabled",
          "allowed_actions"
        ],
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "The repository's own switch."
          },
          "allowed_actions": {
            "type": "string",
            "enum": [
              "all",
              "local_only",
              "selected"
            ],
            "description": "`local_only`: only the repository's own actions; rbit's built-ins (checkout, cache, artifacts) always run."
          },
          "selected_actions_url": {
            "type": "string",
            "description": "Present while `allowed_actions` is `selected`."
          }
        }
      },
      "ActionsRepositoryPermissionsInput": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "allowed_actions": {
            "type": "string",
            "enum": [
              "all",
              "local_only",
              "selected"
            ],
            "description": "`local_only`: only the repository's own actions; rbit's built-ins (checkout, cache, artifacts) always run."
          }
        }
      },
      "ActionsOwnerPermissions": {
        "type": "object",
        "required": [
          "enabled_repositories",
          "allowed_actions"
        ],
        "properties": {
          "enabled_repositories": {
            "type": "string",
            "enum": [
              "all",
              "none",
              "selected"
            ]
          },
          "allowed_actions": {
            "type": "string",
            "enum": [
              "all",
              "local_only",
              "selected"
            ],
            "description": "`local_only`: only the repository's own actions; rbit's built-ins (checkout, cache, artifacts) always run."
          },
          "selected_repositories_url": {
            "type": "string"
          },
          "selected_actions_url": {
            "type": "string"
          }
        }
      },
      "ActionsOwnerPermissionsInput": {
        "type": "object",
        "required": [
          "enabled_repositories"
        ],
        "properties": {
          "enabled_repositories": {
            "type": "string",
            "enum": [
              "all",
              "none",
              "selected"
            ]
          },
          "allowed_actions": {
            "type": "string",
            "enum": [
              "all",
              "local_only",
              "selected"
            ],
            "description": "`local_only`: only the repository's own actions; rbit's built-ins (checkout, cache, artifacts) always run."
          }
        }
      },
      "ActionsSelectedActions": {
        "type": "object",
        "properties": {
          "github_owned_allowed": {
            "type": "boolean",
            "description": "Actions of GitHub's `actions` and `github` organizations."
          },
          "verified_allowed": {
            "type": "boolean",
            "description": "Always false: rbit has no verified creators."
          },
          "patterns_allowed": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "`owner/repo[/path]@ref` (or without `@`, any ref) and `docker://image` patterns; `*` matches anything."
          }
        }
      },
      "ActionsWorkflowPermissions": {
        "type": "object",
        "properties": {
          "default_workflow_permissions": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          },
          "can_approve_pull_request_reviews": {
            "type": "boolean"
          }
        }
      },
      "ActionsForkPrApproval": {
        "type": "object",
        "required": [
          "approval_policy"
        ],
        "properties": {
          "approval_policy": {
            "type": "string",
            "enum": [
              "first_time_contributors_new_to_github",
              "first_time_contributors",
              "all_external_contributors"
            ]
          }
        }
      },
      "ActionsSelectedRepositories": {
        "type": "object",
        "required": [
          "total_count",
          "repositories"
        ],
        "properties": {
          "total_count": {
            "type": "integer"
          },
          "repositories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "full_name": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ActionsSelectedRepositoryIds": {
        "type": "object",
        "required": [
          "selected_repository_ids"
        ],
        "properties": {
          "selected_repository_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "ActionsWorkflowAccess": {
        "type": "object",
        "required": [
          "access_level"
        ],
        "properties": {
          "access_level": {
            "type": "string",
            "enum": [
              "none",
              "user",
              "organization"
            ]
          }
        }
      }
    }
  }
}
