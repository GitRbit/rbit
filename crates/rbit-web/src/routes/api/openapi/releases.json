{
  "paths": {
    "/repos/{owner}/{repo}/releases": {
      "parameters": [
        {
          "$ref": "#/components/parameters/owner"
        },
        {
          "$ref": "#/components/parameters/repo"
        }
      ],
      "get": {
        "operationId": "listReleases",
        "tags": [
          "releases"
        ],
        "summary": "A repository's releases, newest first (drafts first, for writers)",
        "security": [
          {
            "token": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/page"
          },
          {
            "$ref": "#/components/parameters/per_page"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of releases",
            "headers": {
              "Link": {
                "$ref": "#/components/headers/Link"
              },
              "X-Total-Count": {
                "$ref": "#/components/headers/X-Total-Count"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Release"
                  }
                }
              }
            }
          },
          "301": {
            "$ref": "#/components/responses/MovedPermanently"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "operationId": "createRelease",
        "tags": [
          "releases"
        ],
        "summary": "Create a release",
        "description": "Writers with a `write` token; drafts exist only for writers (404 for everyone else). When `tag_name` does not exist yet it is created at `target_commitish` (default: the default branch), reported like a push. Publishing (not a draft) sends the `release` webhook.",
        "security": [
          {
            "token": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReleaseBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": {
                "$ref": "#/components/headers/Location"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Release"
                }
              }
            }
          },
          "307": {
            "$ref": "#/components/responses/TemporaryRedirect"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        }
      }
    },
    "/repos/{owner}/{repo}/releases/latest": {
      "parameters": [
        {
          "$ref": "#/components/parameters/owner"
        },
        {
          "$ref": "#/components/parameters/repo"
        }
      ],
      "get": {
        "operationId": "getLatestRelease",
        "tags": [
          "releases"
        ],
        "summary": "The latest published release",
        "description": "Full releases before pre-releases, newest first; drafts never. 404 when there is none.",
        "security": [
          {
            "token": []
          }
        ],
        "responses": {
          "200": {
            "description": "The release",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Release"
                }
              }
            }
          },
          "301": {
            "$ref": "#/components/responses/MovedPermanently"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/repos/{owner}/{repo}/releases/tags/{tag}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/owner"
        },
        {
          "$ref": "#/components/parameters/repo"
        },
        {
          "name": "tag",
          "in": "path",
          "required": true,
          "description": "The tag's short name (may contain `/`).",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getReleaseByTag",
        "tags": [
          "releases"
        ],
        "summary": "The release of a tag",
        "security": [
          {
            "token": []
          }
        ],
        "responses": {
          "200": {
            "description": "The release",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Release"
                }
              }
            }
          },
          "301": {
            "$ref": "#/components/responses/MovedPermanently"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/repos/{owner}/{repo}/releases/{release_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/owner"
        },
        {
          "$ref": "#/components/parameters/repo"
        },
        {
          "name": "release_id",
          "in": "path",
          "required": true,
          "description": "The release id.",
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "operationId": "getRelease",
        "tags": [
          "releases"
        ],
        "summary": "One release",
        "security": [
          {
            "token": []
          }
        ],
        "responses": {
          "200": {
            "description": "The release",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Release"
                }
              }
            }
          },
          "301": {
            "$ref": "#/components/responses/MovedPermanently"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "operationId": "updateRelease",
        "tags": [
          "releases"
        ],
        "summary": "Change a release; absent fields keep their value",
        "description": "Writers with a `write` token; drafts exist only for writers (404 for everyone else). A new `tag_name` must exist. Turning a draft into a release publishes it (once).",
        "security": [
          {
            "token": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReleaseBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The changed release",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Release"
                }
              }
            }
          },
          "307": {
            "$ref": "#/components/responses/TemporaryRedirect"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        }
      },
      "delete": {
        "operationId": "deleteRelease",
        "tags": [
          "releases"
        ],
        "summary": "Delete a release and its files (the tag stays)",
        "description": "Writers with a `write` token; drafts exist only for writers (404 for everyone else).",
        "security": [
          {
            "token": []
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "307": {
            "$ref": "#/components/responses/TemporaryRedirect"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/repos/{owner}/{repo}/releases/{release_id}/assets": {
      "parameters": [
        {
          "$ref": "#/components/parameters/owner"
        },
        {
          "$ref": "#/components/parameters/repo"
        },
        {
          "name": "release_id",
          "in": "path",
          "required": true,
          "description": "The release id.",
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "operationId": "listReleaseAssets",
        "tags": [
          "releases"
        ],
        "summary": "The files attached to a release, by name",
        "security": [
          {
            "token": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/page"
          },
          {
            "$ref": "#/components/parameters/per_page"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of files",
            "headers": {
              "Link": {
                "$ref": "#/components/headers/Link"
              },
              "X-Total-Count": {
                "$ref": "#/components/headers/X-Total-Count"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReleaseAsset"
                  }
                }
              }
            }
          },
          "301": {
            "$ref": "#/components/responses/MovedPermanently"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "operationId": "uploadReleaseAsset",
        "tags": [
          "releases"
        ],
        "summary": "Attach a file: the request body is the file",
        "description": "Writers with a `write` token; drafts exist only for writers (404 for everyone else). The body streams (no 1 MiB API limit); at most `[releases] max_assets_per_release` files per release. This is the release's `upload_url`.",
        "security": [
          {
            "token": []
          }
        ],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "The file name (required; no slashes, no leading dot).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "description": "Accepted for compatibility and ignored (rbit has no file labels).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "The file's bytes, streamed to disk; `Content-Type` is recorded as the file's type.",
          "content": {
            "*/*": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Uploaded",
            "headers": {
              "Location": {
                "$ref": "#/components/headers/Location"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseAsset"
                }
              }
            }
          },
          "307": {
            "$ref": "#/components/responses/TemporaryRedirect"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "408": {
            "description": "The upload took longer than `[releases] upload_timeout_seconds`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "description": "The file is larger than `[releases] max_asset_bytes`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        }
      }
    },
    "/repos/{owner}/{repo}/releases/assets/{asset_id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/owner"
        },
        {
          "$ref": "#/components/parameters/repo"
        },
        {
          "name": "asset_id",
          "in": "path",
          "required": true,
          "description": "The attached file's id.",
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "operationId": "getReleaseAsset",
        "tags": [
          "releases"
        ],
        "summary": "An attached file: its metadata, or its bytes",
        "security": [
          {
            "token": []
          }
        ],
        "responses": {
          "200": {
            "description": "The metadata as JSON, or with `Accept: application/octet-stream` the file itself (streamed, counted as a download)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseAsset"
                }
              },
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "301": {
            "$ref": "#/components/responses/MovedPermanently"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "operationId": "deleteReleaseAsset",
        "tags": [
          "releases"
        ],
        "summary": "Delete an attached file",
        "description": "Writers with a `write` token; drafts exist only for writers (404 for everyone else).",
        "security": [
          {
            "token": []
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "307": {
            "$ref": "#/components/responses/TemporaryRedirect"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Release": {
        "type": "object",
        "required": [
          "id",
          "url",
          "html_url",
          "assets_url",
          "upload_url",
          "tarball_url",
          "zipball_url",
          "tag_name",
          "name",
          "body",
          "draft",
          "prerelease",
          "created_at",
          "published_at",
          "author",
          "assets"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "html_url": {
            "type": "string",
            "format": "uri"
          },
          "assets_url": {
            "type": "string",
            "format": "uri"
          },
          "upload_url": {
            "type": "string",
            "description": "A URI template: `…/assets{?name,label}`."
          },
          "tarball_url": {
            "type": "string",
            "format": "uri"
          },
          "zipball_url": {
            "type": "string",
            "format": "uri"
          },
          "tag_name": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "The title; the tag name when none was given."
          },
          "body": {
            "type": "string",
            "description": "Markdown notes."
          },
          "draft": {
            "type": "boolean"
          },
          "prerelease": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "author": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Account"
              },
              {
                "type": "null"
              }
            ]
          },
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReleaseAsset"
            }
          }
        }
      },
      "ReleaseAsset": {
        "type": "object",
        "required": [
          "id",
          "url",
          "browser_download_url",
          "name",
          "label",
          "state",
          "content_type",
          "size",
          "download_count",
          "created_at",
          "updated_at",
          "uploader"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "browser_download_url": {
            "type": "string",
            "format": "uri",
            "description": "The web download (signed-in session or public repository)."
          },
          "name": {
            "type": "string"
          },
          "label": {
            "type": "null"
          },
          "state": {
            "type": "string",
            "enum": [
              "uploaded"
            ]
          },
          "content_type": {
            "type": "string",
            "description": "As declared by the uploader; downloads are always `application/octet-stream`."
          },
          "size": {
            "type": "integer"
          },
          "download_count": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "uploader": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Account"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ReleaseBody": {
        "type": "object",
        "properties": {
          "tag_name": {
            "type": "string",
            "description": "Required when creating."
          },
          "target_commitish": {
            "type": "string",
            "description": "Creating only: the branch or commit a missing tag is created at (default: the default branch)."
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "body": {
            "type": "string",
            "maxLength": 125000
          },
          "draft": {
            "type": "boolean",
            "default": false
          },
          "prerelease": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  }
}
