# systemd unit for Rustit. Install:
#
#   sudo useradd --system --home-dir /var/lib/rustit --shell /usr/sbin/nologin rustit
#   sudo install -m 0755 rustit /usr/local/bin/rustit
#   sudo install -d -m 0750 -o root -g rustit /etc/rustit
#   sudo install -m 0640 -o root -g rustit deploy/rustit.example.toml /etc/rustit/rustit.toml
#   sudo install -m 0644 deploy/rustit.service /etc/systemd/system/rustit.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now rustit
#
# Logs: journalctl -u rustit -f. The data directory (/var/lib/rustit) is created by
# systemd (StateDirectory) and owned by the rustit user.

[Unit]
Description=Rustit self-hosted Git platform
Documentation=https://github.com/rustit/rustit/blob/main/docs/deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=rustit
Group=rustit
ExecStart=/usr/local/bin/rustit --config /etc/rustit/rustit.toml serve
Restart=on-failure
RestartSec=5s
# Graceful shutdown: finish requests, stop background jobs, flush SQLite.
KillSignal=SIGTERM
TimeoutStopSec=30s

StateDirectory=rustit
StateDirectoryMode=0750
WorkingDirectory=/var/lib/rustit
Environment=RUSTIT_STORAGE__DATA_DIR=/var/lib/rustit
Environment=RUST_LOG=info
# journald stores log lines verbatim; keep ANSI colour codes out of them.
Environment=NO_COLOR=1
# Git writes temporary files; give it a private /tmp.
PrivateTmp=yes
UMask=0027

# Packfiles and many concurrent connections need file descriptors.
LimitNOFILE=65536

# --- Hardening -------------------------------------------------------------------
# Everything is read-only except the data directory (and the private /tmp).
ProtectSystem=strict
ReadWritePaths=/var/lib/rustit
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
# Binding ports below 1024 is not needed: a reverse proxy listens on 80/443.
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# MemoryDenyWriteExecute is deliberately not set: it is fine for Rustit itself but some
# git builds (PCRE JIT for `git grep`) need writable+executable memory.

[Install]
WantedBy=multi-user.target
